FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# MySQL connection string
# Note: encode special password characters (e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://root:your_password@localhost/hotel_billing

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REPORT_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173

# Email / SMTP (do not commit real credentials)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_SUPPRESS_SEND=true
EMAIL_VERIFICATION_REQUIRED=true
SEND_LOGIN_NOTIFICATIONS=false
ALLOW_DEV_AUTH_TOKENS=true
