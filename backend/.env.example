FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=28800
# Prefer 28800–43200 (8–12h) in production; logout now revokes JWTs via token_version.

# MySQL connection string
# Note: encode special password characters (e.g. @ -> %40)
DATABASE_URL=mysql+pymysql://root:your_password@localhost/hotel_billing

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

REPORT_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5173

# Email / SMTP (do not commit real credentials)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_SUPPRESS_SEND=true
EMAIL_VERIFICATION_REQUIRED=true
SEND_LOGIN_NOTIFICATIONS=false
ALLOW_DEV_AUTH_TOKENS=true

# Master Admin bootstrap (used by scripts/seed_master_admin.py — do not commit real passwords)
# MASTER_ADMIN_EMAIL=admin@yourdomain.com
# MASTER_ADMIN_PASSWORD=
# MASTER_ADMIN_NAME=Prabha Technology Admin

# WhatsApp Cloud API (per-tenant tokens stored encrypted in DB)
# mock = local/CI without Meta calls; meta = live Graph API
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN_ENCRYPTION_KEY=change-me-whatsapp-token-encryption-key
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_APP_SECRET=change-me-meta-app-secret
